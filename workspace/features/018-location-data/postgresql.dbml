// Dữ liệu nền và phiên bản dữ liệu (018-location-data) — GIAI ĐOẠN 1 (+ cột/bảng đánh dấu [GĐ2]).
// Phần để sau (GĐ3) mô tả ở future-schema.md, chưa tạo bảng.
//
// Hai vùng, hai cách quản lý schema (research.md Bản ghi 8):
//   - schema geo: migration SQL viết tay, chạy lặp được (IF NOT EXISTS). Không có entity TypeORM.
//     /reset (dropDatabase → synchronize) KHÔNG đụng geo vì TypeORM chỉ dọn schema entity dùng + current_schema.
//   - schema public (map_*): entity TypeORM; cột mới khai báo trong entity, KHÔNG thêm bằng SQL tay
//     (synchronize sẽ xóa cột không có trong entity).
// Không có khóa ngoại giữa geo và public (reset xóa public bằng CASCADE). Toàn vẹn do service kiểm.
// Không dùng enum Postgres: varchar + CHECK (geo) hoặc union type TypeScript (public).
// Khóa chính UUID v7; bảng đối tượng nhiều dòng dùng bigint identity.
//
// Một đường ghi duy nhất (research.md Bản ghi 12). Mã nguồn: backend/src/modules/map/datasets/geo-migrations.ts.
//   - Mọi phiên bản lớp sinh từ một gói tải lên qua /admin/datasets → geo_staging → admin "Lưu" → geo.
//   - GĐ1 chặn bằng trigger + cờ phiên giao dịch: mọi lệnh ghi bảng đối tượng phải `SET LOCAL geo.write_mode = 'ingest'`
//     (thêm) hoặc 'purge' (dọn). Chỉ module datasets đặt cờ này (test kiến trúc geo-write-boundary.spec.ts).
//     trg_*_guard_insert: chặn INSERT thiếu cờ hoặc vào phiên bản không ở building.
//     trg_*_guard_change / _truncate: chặn UPDATE, TRUNCATE; DELETE chỉ khi cờ purge.
//     trg_layer_versions_guard: chặn tạo phiên bản ngoài đường nhập, chặn sửa phiên bản ready (trừ ready → retired và
//       cột integrity_*), retired → building chỉ khi khôi phục từ gói.
//     trg_map_dataset_versions_guard (public, tạo trong MapDatasetService): chặn đổi nội dung bản đã rời draft.
//   - Tách role database (app_reader / geo_ingest) để khi triển khai production (future-schema.md).
//   - content_hash phát hiện ghi lén bằng superuser.

// ───────────────────────────── geo: lớp và phiên bản lớp ─────────────────────────────

Table geo.layers {
  code varchar(60) [pk, note: 'lớp = (nguồn, chủ đề, dạng hình học): osm.places, osm.roads, worldpop.pop_500m, qhtd.landuse_current…']
  geometry_kind varchar(10) [not null, note: 'check in (point, line, area, grid)']
  source_code varchar(40) [not null, note: 'khớp data/raw/{mien}/{nguon}: osm, worldpop, qhtd-hanoi']
  usage varchar(10) [not null, default: 'public', note: 'check in (public, internal, blocked). internal = chỉ tính, không trả đối tượng ra API']
  contract varchar(12) [not null, note: 'khuôn gói: point@1 | line@1 | area@1 | grid@1 (package-contracts.md). Phải cùng geometry_kind']
  attribution varchar(300) [not null, default: '', note: 'câu ghi nguồn bắt buộc hiển thị']
  description varchar(300) [not null, default: '']
  usage_reason varchar(500) [note: 'lý do lần đổi usage gần nhất (nhật ký đầy đủ ở admin_audit_logs)']
  created_by uuid [note: 'admin tạo lớp trên UI']
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Loại tiện ích (pharmacy, market…) là cột category bên trong lớp, không phải lớp riêng: một gói OSM = một phiên bản osm.places. Tạo lớp trên UI; chỉ usage, attribution, description sửa được sau khi tạo.'
}

Table geo.layer_versions {
  id uuid [pk]
  layer_code varchar(60) [not null, ref: > geo.layers.code]
  label varchar(40) [not null, note: 'ngày nguồn: 2026-10-18']
  status varchar(12) [not null, default: 'building', note: 'check in (building, ready, retired). Gói lỗi dừng ở import_jobs, không tạo phiên bản. Xem diagrams/state-layer-version.mmd']
  import_job_id uuid [not null, ref: - geo.import_jobs.id, note: 'gói đã sinh ra phiên bản này']
  package_sha256 varchar(64) [not null, unique, note: 'khóa tới kho gói (S3 datasets/packages/{layer}/{sha256}.zip); khôi phục phiên bản retired từ đây']
  manifest jsonb [not null, note: 'manifest.json của gói: nguồn, giấy phép, commit pipeline, bước làm tay, params — thay catalog_paths/source_sha256']
  content_hash varchar(64) [note: 'sha256 các dòng sắp theo feature_key, tính lúc ready; job hằng tuần so lại']
  integrity_checked_at timestamptz
  integrity_ok boolean [note: 'false = dữ liệu bị đổi ngoài đường nhập → chặn phát hành mọi bản dùng phiên bản này']
  row_count integer
  coverage geometry(MultiPolygon,4326) [note: 'vùng có dữ liệu; ngoài vùng = no_data, không phải 0']
  checks jsonb [not null, default: '[]', note: '[{code, severity: blocking|warning, status: pass|fail, expected, observed}] chép từ import_jobs lúc lưu']
  accepted_warnings varchar(500) [note: 'lý do admin chấp nhận cảnh báo khi bấm Lưu; có giá trị thì confidence của tiêu chí dùng lớp này hạ một bậc']
  diff_summary jsonb [note: '{"base":"<id>","added":12,"removed":3,"changed":40,"by_category":{…}}']
  created_at timestamptz [not null, default: `now()`]
  ready_at timestamptz
  retired_at timestamptz

  indexes {
    (layer_code, label) [unique, name: 'uk_layer_versions_layer_code_label']
    (status) [name: 'idx_layer_versions_status']
  }
  Note: 'Chỉ module ingest tạo dòng, trong transaction "Lưu" (building → ready). retired → DELETE đối tượng qua hàm dọn, giữ dòng này. Khôi phục: retired → building → ready từ gói, giữ nguyên id nên bảng kê cũ vẫn đúng.'
}

Table geo.import_jobs {
  id uuid [pk]
  layer_code varchar(60) [not null, ref: > geo.layers.code]
  label varchar(40) [not null]
  contract varchar(12) [not null]
  purpose varchar(10) [not null, default: 'new', note: 'check in (new, restore). restore = nạp lại gói của phiên bản retired (GĐ2, chưa có code)']
  status varchar(12) [not null, default: 'uploaded', note: 'check in (uploaded, validating, validated, rejected, saving, saved, discarded, failed). Xem diagrams/state-import-job.mmd']
  package_key varchar(300) [not null, note: 'khóa trong kho S3: datasets/packages/{layer}/{sha256}.zip; rỗng khi gói đã xóa sau 30 ngày']
  package_sha256 varchar(64) [not null]
  size_bytes bigint [not null]
  manifest jsonb [note: 'đã kiểm theo contracts/manifest.schema.json']
  checks jsonb [not null, default: '[]']
  diff_summary jsonb [note: 'so với phiên bản trong bản hiện hành: baseRowCount, rowCount, added, removed, byCategory']
  preview jsonb [note: '20 dòng đầu sau chuẩn hóa (chỉ admin xem)']
  row_count integer [note: 'số dòng hợp lệ đã nạp vào staging']
  accepted_warnings varchar(500)
  error varchar(1000)
  uploaded_by uuid [not null]
  decided_by uuid [note: 'admin bấm Lưu hoặc Bỏ']
  layer_version_id uuid [note: 'có khi saved']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  finished_at timestamptz

  indexes {
    (package_sha256) [unique, name: 'uk_import_jobs_package_sha256', note: 'partial: WHERE purpose = new AND status NOT IN (rejected, discarded, failed) — chặn nạp trùng']
    (layer_code, label) [unique, name: 'uk_import_jobs_layer_code_label', note: 'partial như trên']
    (status, created_at) [name: 'idx_import_jobs_status_created_at']
  }
  Note: 'Mỗi lúc chỉ một job ở validating hoặc saving (pg_try_advisory_lock). Dữ liệu tạm nằm ở geo_staging.* theo job_id, xóa khi saved, rejected, discarded hoặc sau 7 ngày.'
}

// geo_staging: bảng UNLOGGED cùng cột với geo.*_features / geo.grid_values + job_id + line_no; đánh giá không đọc schema này.
// Không vẽ chi tiết: point_rows, line_rows, area_rows, grid_rows, coverages.

// ───────────────────────────── geo: đối tượng (bảng thường, không phân vùng — Bản ghi 8) ─────────────────────────────

Table geo.point_features {
  id bigint [pk, increment]
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  feature_key varchar(120) [not null, note: 'nguồn:id, hoặc băm(category, tên chuẩn hóa, tọa độ làm tròn 10 m)']
  category varchar(30) [not null, note: 'market, pharmacy, supermarket, townhall, hardware, food, park, school, hospital, bus, metro, bank (+GĐ2: fire_station, landfill, cemetery, substation…)']
  kind varchar(30) [not null, default: '']
  name varchar(200) [not null, default: '']
  is_planned boolean [not null, default: false, note: 'quy hoạch, chưa có thật']
  attrs jsonb [not null, default: '{}', note: 'thuộc tính đã chuẩn hóa; merged_from khi gộp trùng trong cùng nguồn (nút và vùng OSM cùng một chợ)']
  geom geography(Point,4326) [not null]

  indexes {
    (layer_version_id, feature_key) [unique, name: 'uk_point_features_layer_version_id_feature_key']
    (layer_version_id, category) [name: 'idx_point_features_layer_version_id_category']
    geom [type: gist, name: 'idx_point_features_geom']
  }
}

Table geo.line_features {
  id bigint [pk, increment]
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  feature_key varchar(120) [not null]
  category varchar(30) [not null, note: 'road (+GĐ2: dike, power_line, rail, metro_line)']
  road_class varchar(20) [note: 'motorway | trunk | primary | secondary | tertiary | residential | alley']
  width_m real [note: 'OSM width hoặc DuongBo.chieuRong; null = không rõ']
  name varchar(200) [not null, default: '']
  is_planned boolean [not null, default: false]
  attrs jsonb [not null, default: '{}']
  geom geography(MultiLineString,4326) [not null]

  indexes {
    (layer_version_id, feature_key) [unique, name: 'uk_line_features_layer_version_id_feature_key']
    (layer_version_id, category, road_class) [name: 'idx_line_features_layer_version_id_category_road_class']
    geom [type: gist, name: 'idx_line_features_geom']
  }
}

Table geo.area_features {
  id bigint [pk, increment]
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  feature_key varchar(120) [not null]
  category varchar(30) [not null, note: '[GĐ2] landuse_current, landuse_plan, hazard_zone, ward, industrial_zone']
  code varchar(30) [note: 'mã loại đất ODT/ONT…, mã đơn vị hành chính']
  name varchar(200) [not null, default: '']
  valid_from date
  valid_to date
  attrs jsonb [not null, default: '{}']
  geom geometry(MultiPolygon,4326) [not null, note: 'đã ST_Subdivide khi nhập (≤ 256 đỉnh mỗi mảnh)']

  indexes {
    (layer_version_id, feature_key) [name: 'idx_area_features_layer_version_id_feature_key', note: 'không unique vì vùng lớn bị chia mảnh']
    (layer_version_id, category) [name: 'idx_area_features_layer_version_id_category']
    geom [type: gist, name: 'idx_area_features_geom']
  }
  Note: 'Bảng có từ GĐ1 (rỗng) để truy vấn đánh giá không phải đổi khi thêm loại đất.'
}

// ───────────────────────────── geo: lưới ─────────────────────────────

Table geo.grids {
  code varchar(30) [pk, note: 'vn2000-100m']
  srid integer [not null, note: '3405']
  cell_size_m integer [not null]
  origin_x double [not null]
  origin_y double [not null]
  columns integer [not null]
  rows integer [not null]
  Note: 'cell_id = hàng * columns + cột, hàng tính từ origin_y đi lên. Không sửa; đổi kích thước ô = lưới mới. Migration tạo sẵn vn2000-100m: EPSG:3405, gốc (523600, 2268000), 878 cột × 1034 hàng.'
}

Table geo.grid_values {
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  grid_code varchar(30) [not null, ref: > geo.grids.code]
  cell_id bigint [not null]
  value real [note: 'null = ô ngoài vùng phủ của nguồn']

  indexes {
    (layer_version_id, cell_id) [pk]
  }
  Note: 'Mỗi chỉ số (pop_500m, green_300m, flood_rp10…) là một lớp; bán kính và tham số nằm trong manifest.params của phiên bản, tiêu chí chỉ trỏ mã lớp. Khi bảng vượt ~20 triệu dòng mới cân nhắc phân vùng.'
}

// ───────────────────────────── public: bản phát hành (entity TypeORM) ─────────────────────────────

Table map_dataset_versions {
  version integer [pk, note: 'sẵn có; tăng dần, không tái sử dụng']
  note varchar(500) [not null, default: '', note: 'sẵn có']
  released_by uuid [note: 'sẵn có']
  released_at timestamptz [note: 'sẵn có; mới: nullable, null khi chưa phát hành']
  kind varchar(10) [not null, default: 'data', note: 'mới. data | criteria | rollback | hotfix']
  status varchar(10) [not null, default: 'published', note: 'mới. draft | published | withdrawn | abandoned. Default published để các dòng cũ hợp lệ']
  base_version integer [note: 'mới. bản làm gốc để chép bảng kê và so tác động']
  layer_manifest jsonb [not null, default: '{}', note: 'mới. {"osm.places":"<layer_version_id>", …}. Không sửa sau khi published']
  criteria_snapshot jsonb [not null, default: '[]', note: 'mới. bản chụp định nghĩa tiêu chí trong code lúc phát hành (id, method, method_version, inputs, params, scoring, base_confidence, min_support, blocking, default_weight, source_label)']
  criteria_hash varchar(64) [note: 'mới. sha256 của criteria_snapshot đã chuẩn hóa; khác hash = định nghĩa đã đổi']
  created_by uuid [note: 'mới']
  withdrawn_at timestamptz [note: 'mới']
  withdraw_reason varchar(500) [note: 'mới']
  checks jsonb [not null, default: '[]', note: 'mới. kết quả kiểm tra mức bản lúc phát hành']
  golden_report jsonb [note: 'mới. điểm mẫu tự chạy lúc phát hành: số kết luận lật, lệch điểm theo tiêu chí, vi phạm expectations. Hiện ghi {skipped: true} vì chưa có logic đánh giá từ dữ liệu nền']
  backend_commit varchar(40) [note: 'mới. commit backend lúc phát hành (biến GIT_COMMIT nếu CI đặt)']
  created_at timestamptz [not null, default: `now()`, note: 'mới']

  indexes {
    (status, version) [name: 'idx_map_dataset_versions_status_version']
    (status) [unique, name: 'uk_map_dataset_versions_status_draft', note: "partial WHERE status = 'draft' (khai trong entity TypeORM)"]
  }
  Note: '''
  Bản hiện hành = max(version) có status = published.
  Tối đa một draft (unique partial index khai trong entity). Trigger bảo vệ tạo lại mỗi lần khởi động và sau /reset.
  Bản cũ (trước 018) có layer_manifest = {} → đánh giá theo chế độ mẫu (sample = true) như hiện nay.
  Một bảng kê cho mọi tiêu chí và cho lớp bản đồ: không tiêu chí nào ghim phiên bản lớp riêng.
  '''
}

// ───────────────────────────── public: kết quả đánh giá ─────────────────────────────

Table map_places {
  id uuid [pk, note: 'sẵn có; giữ nguyên lat/lng, PostGIS dựng điểm lúc truy vấn']
  ward_code varchar(30) [note: '[GĐ2] mới: từ Vietmap Reverse']
  street_name varchar(200) [note: '[GĐ2] mới: từ Vietmap Reverse']
  Note: 'Chỉ liệt kê cột mới.'
}

Table map_place_analyses {
  id uuid [pk, note: 'sẵn có']
  dataset_version integer [not null, ref: > map_dataset_versions.version, note: 'sẵn có: bản đã ghim']
  sample boolean [not null, default: true, note: 'sẵn có; false khi tính từ dữ liệu thật']
  coverage real [note: 'mới. tỷ lệ tiêu chí có số đo dùng được (ok | fallback)']
  Note: 'Cột measurements jsonb sẵn có giữ để đọc kết quả cũ; kết quả mới ghi map_place_measurements. Màn so sánh cảnh báo khi các lượt có dataset_version khác nhau.'
}

Table map_place_measurements {
  analysis_id uuid [ref: > map_place_analyses.id]
  criterion_id varchar(40) [note: 'khớp id trong criteria_snapshot của bản đã ghim']
  method_used varchar(12) [not null, note: 'nearest | count | within_area | grid | travel_time (GĐ2)']
  method_version smallint [not null, note: 'phiên bản cách tính, khớp snapshot (Bản ghi 14)']
  status varchar(10) [not null, note: 'ok | no_data | fallback | failed']
  value real [note: 'số đo gốc']
  unit varchar(10) [note: 'm | min | people | pct']
  value_code varchar(60) [note: 'giá trị dạng mã (ODT…)']
  auto_score real [note: '0–10 theo scoring']
  verdict varchar(8) [not null, note: 'strong | neutral | weak | unknown']
  confidence varchar(6) [not null, note: 'high | medium | low. = base_confidence, hạ một bậc khi fallback, dưới min_support, hoặc lớp có cảnh báo đã chấp nhận']
  blocking_hit boolean [not null, default: false, note: 'điều kiện chặn của tiêu chí xảy ra → điểm tổng bị giới hạn ở cap lúc đọc']
  evidence jsonb [not null, default: '{}', note: 'đối tượng gần nhất (tên, khoảng cách), số đếm; lớp internal chỉ ghi loại + khoảng cách']
  lineage jsonb [not null, default: '{}', note: '{"layer_versions":["…"],"backend_commit":"…","provider":"vietmap","called_at":"…"}; layer_versions chỉ chứa id có trong bảng kê của bản đã ghim']
  measured_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [note: '[GĐ2] travel_time']

  indexes {
    (analysis_id, criterion_id) [pk]
  }
}
