// Xác thực (003-auth). Quy ước: bảng snake_case số nhiều, cột snake_case số ít, khóa ngoại <entity>_id.
// Khóa chính UUID v7 (sắp xếp được theo thời gian, sinh ở ứng dụng).
// Cột role/status của users do 004-rbac định nghĩa ngữ nghĩa; nằm ở đây để một bảng người dùng duy nhất.

Enum user_role {
  user
  admin
  // guest không phải bản ghi: là người chưa đăng nhập
}

Enum user_status {
  active
  locked   // bị khóa bởi admin hoặc hệ thống; mọi phiên bị thu hồi
  deleted  // đã yêu cầu xóa; chờ xóa hẳn
}

Enum auth_provider {
  google
  password
}

Enum session_revoke_reason {
  logout            // người dùng tự đăng xuất
  logout_other      // đăng xuất từ thiết bị khác
  logout_all
  reuse_detected    // refresh token bị dùng lại
  password_changed
  account_locked
  account_deleted
  evicted           // vượt số phiên tối đa
  expired           // hết hạn tuyệt đối hoặc không hoạt động
  admin_revoked
}

Table users {
  id uuid [pk, note: 'UUID v7']
  email varchar(254) [not null, note: 'chữ thường; so sánh không phân biệt hoa thường (citext hoặc lower())']
  email_verified_at timestamptz [note: 'null = chưa xác minh']
  display_name varchar(100) [not null]
  avatar_url varchar(512)
  role user_role [not null, default: 'user']
  status user_status [not null, default: 'active']
  password_hash varchar(255) [note: 'Argon2id; null nếu chỉ dùng Google']
  password_changed_at timestamptz
  failed_login_count int [not null, default: 0, note: 'chỉ để thống kê; giới hạn thật nằm ở Redis']
  last_login_at timestamptz
  locale varchar(5) [not null, default: 'vi']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    lower(email) [unique, name: 'uk_users_email']
    (status) [name: 'idx_users_status']
    (role) [name: 'idx_users_role', note: 'ít dòng admin; để liệt kê nhanh']
  }
}

// Một người dùng có thể liên kết nhiều nhà cung cấp. Khóa danh tính là (provider, provider_user_id), không phải email.
Table auth_identities {
  id uuid [pk]
  user_id uuid [not null]
  provider auth_provider [not null]
  provider_user_id varchar(255) [not null, note: 'Google: claim sub. Password: trùng user_id']
  email_at_link varchar(254) [note: 'email do nhà cung cấp trả khi liên kết']
  created_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz

  indexes {
    (provider, provider_user_id) [unique, name: 'uk_auth_identities_provider_provider_user']
    (user_id) [name: 'idx_auth_identities_user_id']
  }
}

// Mỗi dòng là một thiết bị/trình duyệt đăng nhập. id chính là sid trong access token.
// Nguồn sự thật của phiên; Redis chỉ là bộ đệm nhanh.
Table auth_sessions {
  id uuid [pk, note: 'sid']
  user_id uuid [not null]
  refresh_hash char(64) [not null, note: 'SHA-256 hex của refresh token hiện tại']
  previous_refresh_hash char(64) [note: 'băm token trước để chấp nhận thử lại trong 10 giây']
  rotated_at timestamptz [note: 'lần xoay gần nhất']
  auth_method auth_provider [not null]
  auth_time timestamptz [not null, note: 'lần xác thực mạnh gần nhất (cho step-up)']
  client_type varchar(10) [not null, default: 'web', note: 'web | native']
  device_label varchar(80) [not null, note: 'người dùng đổi được; mặc định từ user agent']
  user_agent varchar(255)
  ip_address inet [note: 'IP lúc tạo']
  last_ip_address inet [note: 'IP lúc refresh gần nhất']
  country_code char(2) [note: 'tra từ IP; nếu có']
  created_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz [not null, note: 'cập nhật khi refresh, không cập nhật mỗi request']
  idle_expires_at timestamptz [not null, note: 'trượt 14 ngày mỗi lần refresh']
  absolute_expires_at timestamptz [not null, note: 'cố định 30 ngày từ lúc tạo']
  revoked_at timestamptz
  revoked_reason session_revoke_reason

  indexes {
    refresh_hash [unique, name: 'uk_auth_sessions_refresh_hash']
    previous_refresh_hash [name: 'idx_auth_sessions_previous_refresh_hash']
    (user_id, revoked_at) [name: 'idx_auth_sessions_user_id_revoked_at']
    (idle_expires_at) [name: 'idx_auth_sessions_idle_expires_at', note: 'cho job dọn dẹp']
  }
}

// Token một lần: xác minh email, đặt lại mật khẩu. Chỉ lưu băm.
Table auth_one_time_tokens {
  id uuid [pk]
  user_id uuid [not null]
  purpose varchar(20) [not null, note: 'verify_email | reset_password']
  token_hash char(64) [not null]
  expires_at timestamptz [not null]
  used_at timestamptz
  ip_address inet
  created_at timestamptz [not null, default: `now()`]

  indexes {
    token_hash [unique, name: 'uk_auth_one_time_tokens_token_hash']
    (user_id, purpose) [name: 'idx_auth_one_time_tokens_user_id_purpose']
  }
}

// Nhật ký sự kiện bảo mật. Chỉ thêm, không sửa. Lưu 12 tháng (khớp 005-legal), sau đó xóa theo lô.
Table auth_events {
  id uuid [pk]
  user_id uuid [note: 'null nếu chưa xác định được (đăng nhập sai email lạ)']
  session_id uuid
  type varchar(40) [not null, note: 'login_success, login_failed, logout, refresh_reuse_detected, session_revoked, password_changed, account_locked, reauth_success, ...']
  ip_address inet
  user_agent varchar(255)
  meta jsonb [note: 'không chứa token, mật khẩu hay email đầy đủ của người lạ']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: 'idx_auth_events_user_id_created_at']
    (type, created_at) [name: 'idx_auth_events_type_created_at']
    (created_at) [name: 'idx_auth_events_created_at']
  }
}

Ref fk_auth_identities_users: auth_identities.user_id > users.id [delete: cascade]
Ref fk_auth_sessions_users: auth_sessions.user_id > users.id [delete: cascade]
Ref fk_auth_one_time_tokens_users: auth_one_time_tokens.user_id > users.id [delete: cascade]
Ref fk_auth_events_users: auth_events.user_id > users.id [delete: set null]
