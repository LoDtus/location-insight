// Dữ liệu nền và phiên bản dữ liệu (018-location-data) — GIAI ĐOẠN 1 (+ cột/bảng đánh dấu [GĐ2]).
// Phần để sau (GĐ3) mô tả ở future-schema.md, chưa tạo bảng.
//
// Hai vùng, hai cách quản lý schema (research.md Bản ghi 8):
//   - schema geo: migration SQL viết tay, chạy lặp được (IF NOT EXISTS). Không có entity TypeORM.
//     /reset (dropDatabase → synchronize) KHÔNG đụng geo vì TypeORM chỉ dọn schema entity dùng + current_schema.
//   - schema public (map_*): entity TypeORM; cột mới khai báo trong entity, KHÔNG thêm bằng SQL tay
//     (synchronize sẽ xóa cột không có trong entity).
// Không có khóa ngoại giữa geo và public (reset xóa public bằng CASCADE). Toàn vẹn do service kiểm.
// Không dùng enum Postgres: varchar + CHECK (geo) hoặc union type TypeScript (public).
// Khóa chính UUID v7; bảng đối tượng nhiều dòng dùng bigint identity.

// ───────────────────────────── geo: lớp và phiên bản lớp ─────────────────────────────

Table geo.layers {
  code varchar(60) [pk, note: 'lớp = (nguồn, chủ đề, dạng hình học): osm.places, osm.roads, worldpop.pop_500m, qhtd.landuse_current…']
  geometry_kind varchar(10) [not null, note: 'check in (point, line, area, grid)']
  source_code varchar(40) [not null, note: 'khớp data/raw/{mien}/{nguon}: osm, worldpop, qhtd-hanoi']
  usage varchar(10) [not null, default: 'public', note: 'check in (public, internal, blocked). internal = chỉ tính, không trả đối tượng ra API']
  attribution varchar(300) [not null, default: '', note: 'câu ghi nguồn bắt buộc hiển thị']
  description varchar(300) [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Loại tiện ích (pharmacy, market…) là cột category bên trong lớp, không phải lớp riêng: một lần nhập OSM = một phiên bản osm.places.'
}

Table geo.layer_versions {
  id uuid [pk]
  layer_code varchar(60) [not null, ref: > geo.layers.code]
  label varchar(40) [not null, note: 'ngày nguồn: 2026-10-18']
  status varchar(12) [not null, default: 'building', note: 'check in (building, ready, failed, retired). Xem diagrams/state-layer-version.mmd']
  pipeline_version varchar(40) [not null, note: 'commit của tools/data đã dựng']
  catalog_paths "text[]" [not null, note: 'biên bản data/catalog/snapshots/... đã dùng — thay cho bảng sources/source_snapshots']
  source_sha256 "text[]" [not null, note: 'cùng thứ tự catalog_paths; đối chiếu khi nhập']
  row_count integer
  coverage geometry(MultiPolygon,4326) [note: 'vùng có dữ liệu; ngoài vùng = no_data, không phải 0']
  checks jsonb [not null, default: '[]', note: '[{code, severity: blocking|warning, status: pass|fail, expected, observed}] do script ghi']
  diff_summary jsonb [note: '{"base":"<id>","added":12,"removed":3,"changed":40,"by_category":{…}}']
  created_at timestamptz [not null, default: `now()`]
  ready_at timestamptz
  retired_at timestamptz

  indexes {
    (layer_code, label) [unique, name: 'uq_geo_layer_versions_layer_label']
    (status) [name: 'idx_geo_layer_versions_status']
  }
  Note: 'ready chỉ khi không có check blocking fail. retired → DELETE đối tượng, giữ dòng này để truy vết.'
}

// ───────────────────────────── geo: đối tượng (bảng thường, không phân vùng — Bản ghi 8) ─────────────────────────────

Table geo.point_features {
  id bigint [pk, increment]
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  feature_key varchar(120) [not null, note: 'nguồn:id, hoặc băm(category, tên chuẩn hóa, tọa độ làm tròn 10 m)']
  category varchar(30) [not null, note: 'market, pharmacy, supermarket, townhall, hardware, food, park, school, hospital, bus, metro, bank (+GĐ2: fire_station, landfill, cemetery, substation…)']
  kind varchar(30) [not null, default: '']
  name varchar(200) [not null, default: '']
  is_planned boolean [not null, default: false, note: 'quy hoạch, chưa có thật']
  attrs jsonb [not null, default: '{}', note: 'thuộc tính đã chuẩn hóa; merged_from khi gộp trùng trong cùng nguồn (nút và vùng OSM cùng một chợ)']
  geom geography(Point,4326) [not null]

  indexes {
    (layer_version_id, feature_key) [unique, name: 'uq_geo_point_features_version_key']
    (layer_version_id, category) [name: 'idx_geo_point_features_version_category']
    geom [type: gist, name: 'gix_geo_point_features_geom']
  }
}

Table geo.line_features {
  id bigint [pk, increment]
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  feature_key varchar(120) [not null]
  category varchar(30) [not null, note: 'road (+GĐ2: dike, power_line, rail, metro_line)']
  road_class varchar(20) [note: 'motorway | trunk | primary | secondary | tertiary | residential | alley']
  width_m real [note: 'OSM width hoặc DuongBo.chieuRong; null = không rõ']
  name varchar(200) [not null, default: '']
  is_planned boolean [not null, default: false]
  attrs jsonb [not null, default: '{}']
  geom geography(MultiLineString,4326) [not null]

  indexes {
    (layer_version_id, feature_key) [unique, name: 'uq_geo_line_features_version_key']
    (layer_version_id, category, road_class) [name: 'idx_geo_line_features_version_class']
    geom [type: gist, name: 'gix_geo_line_features_geom']
  }
}

Table geo.area_features {
  id bigint [pk, increment]
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  feature_key varchar(120) [not null]
  category varchar(30) [not null, note: '[GĐ2] landuse_current, landuse_plan, hazard_zone, ward, industrial_zone']
  code varchar(30) [note: 'mã loại đất ODT/ONT…, mã đơn vị hành chính']
  name varchar(200) [not null, default: '']
  valid_from date
  valid_to date
  attrs jsonb [not null, default: '{}']
  geom geometry(MultiPolygon,4326) [not null, note: 'đã ST_Subdivide khi nhập (≤ 256 đỉnh mỗi mảnh)']

  indexes {
    (layer_version_id, feature_key) [name: 'idx_geo_area_features_version_key', note: 'không unique vì vùng lớn bị chia mảnh']
    (layer_version_id, category) [name: 'idx_geo_area_features_version_category']
    geom [type: gist, name: 'gix_geo_area_features_geom']
  }
  Note: 'Bảng có từ GĐ1 (rỗng) để truy vấn đánh giá không phải đổi khi thêm loại đất.'
}

// ───────────────────────────── geo: lưới ─────────────────────────────

Table geo.grids {
  code varchar(30) [pk, note: 'vn2000-100m']
  srid integer [not null, note: '3405']
  cell_size_m integer [not null]
  origin_x double [not null]
  origin_y double [not null]
  columns integer [not null]
  rows integer [not null]
  Note: 'cell_id = hàng * columns + cột. Không sửa; đổi kích thước ô = lưới mới.'
}

Table geo.grid_values {
  layer_version_id uuid [not null, ref: > geo.layer_versions.id]
  grid_code varchar(30) [not null, ref: > geo.grids.code]
  cell_id bigint [not null]
  value real [note: 'null = ô ngoài vùng phủ của nguồn']

  indexes {
    (layer_version_id, cell_id) [pk]
  }
  Note: 'Mỗi chỉ số (pop_500m, green_300m, flood_rp10…) là một lớp. Khi bảng vượt ~20 triệu dòng mới cân nhắc phân vùng.'
}

// ───────────────────────────── public: bản phát hành (entity TypeORM) ─────────────────────────────

Table map_dataset_versions {
  version integer [pk, note: 'sẵn có; tăng dần, không tái sử dụng']
  note varchar(500) [not null, default: '', note: 'sẵn có']
  released_by uuid [note: 'sẵn có']
  released_at timestamptz [note: 'sẵn có; mới: null khi chưa phát hành']
  kind varchar(10) [not null, default: 'data', note: 'mới. data | criteria | rollback | hotfix']
  status varchar(10) [not null, default: 'published', note: 'mới. draft | published | withdrawn | abandoned. Default published để các dòng cũ hợp lệ']
  base_version integer [note: 'mới. bản làm gốc để chép bảng kê và so tác động']
  layer_manifest jsonb [not null, default: '{}', note: 'mới. {"osm.places":"<layer_version_id>", …}. Không sửa sau khi published']
  criteria_snapshot jsonb [not null, default: '[]', note: 'mới. bản chụp định nghĩa tiêu chí trong code lúc phát hành (id, method, inputs, params, scoring, default_weight, source_label)']
  criteria_hash varchar(64) [note: 'mới. sha256 của criteria_snapshot đã chuẩn hóa; khác hash = định nghĩa đã đổi']
  created_by uuid [note: 'mới']
  withdrawn_at timestamptz [note: 'mới']
  withdraw_reason varchar(500) [note: 'mới']

  indexes {
    (status, version) [name: 'idx_map_dataset_versions_status_version']
  }
  Note: '''
  Bản hiện hành = max(version) có status = published.
  Tối đa một draft (unique partial index status = draft — tạo bằng SQL idempotent trong service, như messaging-schema.service).
  Bản cũ (trước 018) có layer_manifest = {} → đánh giá theo chế độ mẫu (sample = true) như hiện nay.
  '''
}

// ───────────────────────────── public: kết quả đánh giá ─────────────────────────────

Table map_places {
  id uuid [pk, note: 'sẵn có; giữ nguyên lat/lng, PostGIS dựng điểm lúc truy vấn']
  ward_code varchar(30) [note: '[GĐ2] mới: từ Vietmap Reverse']
  street_name varchar(200) [note: '[GĐ2] mới: từ Vietmap Reverse']
  Note: 'Chỉ liệt kê cột mới.'
}

Table map_place_analyses {
  id uuid [pk, note: 'sẵn có']
  dataset_version integer [not null, ref: > map_dataset_versions.version, note: 'sẵn có: bản đã ghim']
  sample boolean [not null, default: true, note: 'sẵn có; false khi tính từ dữ liệu thật']
  coverage real [note: 'mới. tỷ lệ tiêu chí có số đo dùng được (ok | fallback)']
  Note: 'Cột measurements jsonb sẵn có giữ để đọc kết quả cũ; kết quả mới ghi map_place_measurements.'
}

Table map_place_measurements {
  analysis_id uuid [ref: > map_place_analyses.id]
  criterion_id varchar(40) [note: 'khớp id trong criteria_snapshot của bản đã ghim']
  method_used varchar(12) [not null, note: 'nearest | count | within_area | grid | travel_time (GĐ2)']
  status varchar(10) [not null, note: 'ok | no_data | fallback | failed']
  value real [note: 'số đo gốc']
  unit varchar(10) [note: 'm | min | people | pct']
  value_code varchar(60) [note: 'giá trị dạng mã (ODT…)']
  auto_score real [note: '0–10 theo scoring']
  verdict varchar(8) [not null, note: 'strong | neutral | weak | unknown']
  confidence varchar(6) [not null, note: 'high | medium | low']
  evidence jsonb [not null, default: '{}', note: 'đối tượng gần nhất (tên, khoảng cách), số đếm; lớp internal chỉ ghi loại + khoảng cách']
  lineage jsonb [not null, default: '{}', note: '{"layer_versions":["…"],"provider":"vietmap","called_at":"…"}']
  measured_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [note: '[GĐ2] travel_time']

  indexes {
    (analysis_id, criterion_id) [pk]
  }
}
