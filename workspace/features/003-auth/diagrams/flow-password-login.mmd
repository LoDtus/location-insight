%% Đăng ký / đăng nhập mật khẩu / quên mật khẩu (chỉ khi AUTH_PASSWORD_ENABLED=true)
flowchart TD
    A[POST /auth/register] --> A1{Rate limit IP}
    A1 -- vượt --> X1[429]
    A1 -- ok --> A2[Kiểm tra mật khẩu: 10-128 ký tự, không nằm trong danh sách bị lộ]
    A2 -- sai --> X2[422 mã lỗi, không nêu email đã tồn tại]
    A2 -- ok --> A3[Tạo user chưa xác minh + gửi email xác minh]
    A3 --> A4[Luôn trả 202 cùng nội dung dù email đã tồn tại]
    A4 --> V[POST /auth/verify-email token một lần, TTL 24h]
    V --> L

    L[POST /auth/login] --> L1{Rate limit IP và độ trễ tài khoản}
    L1 -- bị chặn --> X3[429 kèm Retry-After]
    L1 -- ok --> L2[Tìm user theo email, luôn chạy Argon2id để thời gian đều nhau]
    L2 -- sai hoặc chưa xác minh hoặc locked --> L3[Tăng bộ đếm Redis, 401 invalid_credentials cùng nội dung]
    L2 -- đúng --> L4[Tạo phiên như đăng nhập Google]

    F[POST /auth/forgot-password] --> F1[Luôn trả 202, nếu email tồn tại thì gửi link, token 15 phút, một lần]
    F1 --> F2[POST /auth/reset-password: đặt hash mới, thu hồi mọi phiên, ghi password_changed]
