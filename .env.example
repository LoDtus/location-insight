# Copy sang .env.development và .env.production rồi sửa theo từng môi trường.
# Dev: make dev-up. Backend trong Docker ghi đè host của Postgres, Redis, Elasticsearch và MinIO.

# ==================== Website ====================
WEBSITE_PORT=22360

# ==================== Backend ====================
BACKEND_PORT=22370
GLOBAL_PREFIX=api/v1
APPLICATION_NAME=Location Insight
NODE_ENV=development
CORS_ORIGINS=http://localhost:22360,http://127.0.0.1:22360

# ==================== Postgres ====================
POSTGRES_PORT=22371
DATABASE_HOST=localhost
DATABASE_PORT=22371
DATABASE_USER=location
DATABASE_PASSWORD=location
DATABASE_NAME=location_insight
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# ==================== Redis ====================
REDIS_PORT=22372
REDIS_HOST=localhost
REDIS_PASSWORD=

# ==================== Elasticsearch ====================
ELASTICSEARCH_PORT=22373
ELASTICSEARCH_NODE=http://localhost:22373
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# false = không kết nối ES, mọi tìm kiếm dùng PostgreSQL. ES luôn là phụ thuộc tùy chọn.
ELASTICSEARCH_ENABLED=true
# Profile được dùng ES, cách nhau dấu phẩy. Rỗng = không nơi nào dùng ES (xem workspace/features/017-search-elasticsearch).
ELASTICSEARCH_PROFILES=
# Tiền tố tên index/alias khi dùng chung cụm (kebab-case, ví dụ li-dev-). Thường để trống.
ELASTICSEARCH_INDEX_PREFIX=
ELASTICSEARCH_SEARCH_TIMEOUT_MS=2000
ELASTICSEARCH_SYNC_INTERVAL_MS=2000
ELASTICSEARCH_SYNC_BATCH=200

# ==================== Kho đối tượng S3 (MinIO local / Cloudflare R2) ====================
# S3_REGION: MinIO dùng us-east-1; R2 dùng auto. Xem workspace/features/016-media-storage/configuration.md.
MINIO_API_PORT=22374
MINIO_CONSOLE_PORT=22375
S3_ENDPOINT=http://localhost:22374
# URL trình duyệt dùng để tải thẳng từ kho (URL ký). Prod: https://<miền media>; R2: giống S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:22374
S3_REGION=us-east-1
S3_ACCESS_KEY=location
S3_SECRET_KEY=locationsecret
S3_BUCKET=location-insight
S3_FORCE_PATH_STYLE=true
# Tự tạo bucket + đặt CORS khi khởi động. Chỉ true ở dev; prod tạo bucket và CORS thủ công.
S3_AUTO_CREATE_BUCKET=true
# Origin web được gọi thẳng tới kho. Bỏ trống thì dùng CORS_ORIGINS.
S3_CORS_ORIGINS=
S3_REQUEST_TIMEOUT_MS=5000

# ==================== Auth ====================
# Chỉ những giá trị bí mật hoặc hay đổi khi dev. TTL, hạn mức, bảng quyền nằm trong mã.
# Sinh khóa: node -e "const {generateKeyPairSync}=require('crypto'); const {publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'}); console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64')); console.log(Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'));"
AUTH_JWT_KID=dev-1
AUTH_JWT_PRIVATE_KEY=replace-with-base64-pkcs8
AUTH_JWT_PUBLIC_KEYS=dev-1:replace-with-base64-spki
AUTH_JWT_ISSUER=location-insight
AUTH_JWT_AUDIENCE=location-insight-api
AUTH_PASSWORD_ENABLED=false
AUTH_ALLOWED_ORIGINS=http://localhost:22360,http://127.0.0.1:22360
AUTH_ALLOWED_REDIRECTS=/app/properties,/app/map,/app,/admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:22370/api/v1/auth/google/callback
TRUST_PROXY_HOPS=1
ADMIN_ALLOWED_CIDRS=
ANALYSIS_BUDGET_GUARD=false

# ==================== SePay ====================
# Khóa webhook và tài khoản nhận. Để trống thì catalog vẫn đọc được, tạo đơn trả 503.
# Trên SePay: mẫu mã tiền tố trùng SEPAY_PAYMENT_PREFIX, hậu tố 8 ký tự chữ và số.
# Webhook: POST https://<domain>/api/v1/billing/sepay/webhook  header Authorization: Apikey <khóa>
# Trên SePay chọn xác thực "API Key". SePay chỉ cho chọn một kiểu, nên để SEPAY_WEBHOOK_HMAC_SECRET trống
# (nếu đặt, backend đòi thêm chữ ký x-sepay-signature mà kiểu API Key không gửi, mọi webhook sẽ bị 401).
SEPAY_WEBHOOK_API_KEY=
SEPAY_WEBHOOK_HMAC_SECRET=
# Dùng tài khoản ảo (VA) thì điền số VA người trả chuyển tới (ví dụ AGBSP2LVIPAY); webhook khớp cả accountNumber lẫn subAccount.
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=DT

# Giá thử (VND). Có giá trị: mọi gói, mọi kỳ và mọi lượt định giá đều thu đúng số này (kiểm tra luồng chuyển khoản).
# Để trống: dùng bảng giá thật trong backend/src/modules/billing/billing.constants.ts. Số nguyên 1000-1000000.
# Đổi xong chỉ cần khởi động lại backend. Khi bật, log backend có cảnh báo "Đang dùng GIÁ THỬ".
BILLING_TEST_PRICE_VND=

# ==================== Nhắn tin ====================
# true: chỉ tài khoản đã xác minh email mới được nhắn tin (đọc thì không cần)
MESSAGING_REQUIRE_VERIFIED_EMAIL=false

# ==================== Email ====================
# Dev: Mailpit (make dev-up) nhận mọi thư tại http://localhost:22377; không cần tài khoản thật.
# Production: dùng SMTP của SES/Postmark/SendGrid..., MAIL_DRIVER=smtp, cổng 587 (STARTTLS) hoặc 465 + MAIL_SECURE=true.
# MAIL_DRIVER=log: chỉ ghi log, không gửi. Để trống MAIL_HOST thì tự dùng log.
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=22376
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@diathe.local
MAIL_FROM_NAME=Địa Thế
MAIL_REPLY_TO=
MAIL_SUPPORT_EMAIL=support@diathe.local
MAIL_APP_NAME=Địa Thế
# Bản gốc của link trong email (mặc định: origin đầu tiên của AUTH_ALLOWED_ORIGINS)
APP_PUBLIC_URL=
# false: tắt worker gửi trong tiến trình này (chạy worker ở tiến trình riêng)
MAIL_WORKER_ENABLED=true
# Khóa HMAC ký link hủy đăng ký, >= 16 ký tự. Production bắt buộc (openssl rand -base64 32).
EMAIL_LINK_SECRET=
MAILPIT_SMTP_PORT=22376
MAILPIT_UI_PORT=22377

# ==================== Vietmap (013-map) ====================
# Khóa API (search, route…): CHỈ dùng ở backend. Tạo ở https://maps.vietmap.vn/console-v2/
VIETMAP_API_KEY=
# Khóa Tilemap: nằm trong style URL nên lộ ở trình duyệt → bắt buộc hạn chế domain trong Console.
VIETMAP_TILE_KEY=
# VIETMAP_BASE_URL=https://maps.vietmap.vn
# VIETMAP_TIMEOUT_MS=4000
# Trần số lần gọi upstream mỗi ngày (0 = không giới hạn). Trial: 1.500/ngày/API.
MAP_DAILY_BUDGET=1200
# Chỉ bật khi khóa Tilemap đã được bật API Traffic trong Console.
MAP_TRAFFIC_ENABLED=false
# Khóa OpenAQ v3 cho tiêu chí không khí (đăng ký miễn phí tại https://explore.openaq.org). Trống: tiêu chí
# không khí ghi "chưa đo được" và không tính vào điểm. Chỉ dùng ở backend (header X-API-Key).
OPENAQ_API_KEY=
# OPENAQ_BASE_URL=https://api.openaq.org

# ==================== Web Push (014-notification) ====================
# Tạo cặp khóa bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@location-insight.local
# 32 byte hex: openssl rand -hex 32
NOTIFICATION_PUSH_ENC_KEY=

# =========================================================
# CÔNG CỤ RESET DỮ LIỆU DEV (CHỈ MÁY DEV — TUYỆT ĐỐI KHÔNG BẬT Ở NƠI KHÁC)
# Truy cập <host>:<WEBSITE_PORT>/reset để xóa toàn bộ database, dựng lại bảng và seed lại.
# Production/staging: để false hoặc xóa cả hai biến; nếu đặt true, backend từ chối khởi động.
# Sinh token: openssl rand -hex 32
# =========================================================
DEV_RESET_ENABLED=false
DEV_RESET_TOKEN=

# Commit backend ghi vào bản phát hành dữ liệu (018-location-data). CI đặt lúc build; để trống thì ghi null.
GIT_COMMIT=
