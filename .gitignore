# Database & Local Services
# =========================================================
*.db
*.db-journal
*.sqlite
*.sqlite3

# Data lake: keep the layout, docs, and ingest receipts.
# Payloads (pbf, tif, parquet, scrapes, ...) stay on disk only.
/data/**
!/data/README.md
!/data/**/
!/data/**/.gitkeep
!/data/catalog/**/*.json
!/data/catalog/**/*.yaml
!/data/catalog/**/*.yml
!/data/catalog/**/*.md

/disk
.db-data/
postgres-data/
mysql-data/
mongo-data/
elasticsearch-data/
redis-data/

# =========================================================
# Local Python Environments
# =========================================================
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]

# =========================================================
# Local Disk Storage
# =========================================================
# Uncomment only if disk/default contains runtime-generated files:
# /disk/default/*
# !/disk/default/.gitkeep

# Uncomment only if disk/example contains local-only files:
# /disk/example/*
# !/disk/example/.gitkeep

