# Copy sang .env.development và .env.production rồi sửa theo từng môi trường.
# Dev: make dev-up. Backend trong Docker ghi đè host của Postgres, Redis, Elasticsearch và MinIO.

# ==================== Website ====================
WEBSITE_PORT=22360

# ==================== Backend ====================
BACKEND_PORT=22370
GLOBAL_PREFIX=api/v1
APPLICATION_NAME=Location Insight
NODE_ENV=development
CORS_ORIGINS=http://localhost:22360,http://127.0.0.1:22360

# ==================== Postgres ====================
POSTGRES_PORT=22371
DATABASE_HOST=localhost
DATABASE_PORT=22371
DATABASE_USER=location
DATABASE_PASSWORD=location
DATABASE_NAME=location_insight
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# ==================== Redis ====================
REDIS_PORT=22372
REDIS_HOST=localhost
REDIS_PASSWORD=

# ==================== Elasticsearch ====================
ELASTICSEARCH_PORT=22373
ELASTICSEARCH_NODE=http://localhost:22373
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ==================== MinIO (S3 local) ====================
MINIO_API_PORT=22374
MINIO_CONSOLE_PORT=22375
S3_ENDPOINT=http://localhost:22374
S3_REGION=us-east-1
S3_ACCESS_KEY=location
S3_SECRET_KEY=locationsecret
S3_BUCKET=location-insight
S3_FORCE_PATH_STYLE=true
